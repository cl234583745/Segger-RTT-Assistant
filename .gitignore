# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
.venv/

# Build
build/
dist/
*.spec.bak

# Runtime (users manage these, too large for git)
runtime/venv/
runtime/dll/*.dll
runtime/packs/*.pack
runtime/cpm_cache/
!runtime/dll/.gitkeep
!runtime/packs/.gitkeep

# Config (user-specific, auto-generated)
config/config.json
config/devices.txt
config/pyocd_targets.txt

# Logs
*.log
log/

# Test cache
.pytest_cache/

# Doc build artifacts (keep .md source, ignore generated .html)
doc/*.html

# Temp files
frames/
video*/
*.tmp
*TEMP_MPY*
ScreenShot*.png

# IDE
.vscode/
.idea/
.arts/
.codeartsdoer/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
desktop.ini
